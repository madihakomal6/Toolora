"use client"
import { useState } from "react"
import Link from "next/link"

export default function AgeCalculator() {
  const [dob, setDob] = useState("")
  const [result, setResult] = useState("")

  const calculateAge = () => {
    if (!dob) return

    const birthDate = new Date(dob)
    const today = new Date()

    let years = today.getFullYear() - birthDate.getFullYear()
    let months = today.getMonth() - birthDate.getMonth()
    let days = today.getDate() - birthDate.getDate()

    if (days < 0) {
      months--
      days += new Date(today.getFullYear(), today.getMonth(), 0).getDate()
    }
    if (months < 0) {
      years--
      months += 12
    }

    setResult(`Aap ki age hai: ${years} Saal, ${months} Mahine, ${days} Din`)
  }

  return (
    <div className="min-h-screen bg-gray-100">
      <header className="bg-white shadow p-4 flex justify-between items-center">
        <h1 className="text-2xl font-bold text-blue-600">Age Calculator</h1>
        <Link href="/" className="text-blue-500 hover:underline">← Back to Home</Link>
      </header>

      <div className="container mx-auto max-w-md mt-10 p-6 bg-white rounded-2xl shadow">
        <h2 className="text-xl font-semibold mb-4 text-center">Apni Age Nikalo</h2>
        
        <input 
          type="date" 
          id="dob"
          value={dob}
          onChange={(e) => setDob(e.target.value)}
          className="w-full border-gray-300 rounded-lg p-3 mb-4"
        />
        
        <button 
          onClick={calculateAge}
          className="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700"
        >
          Calculate Age
        </button>

        {result && (
          <div className="mt-6 p-4 bg-green-100 text-green-800 rounded-lg text-center font-medium">
            {result}
          </div>
        )}
      </div>
    </div>
  )
}
